/* 試合中の HUD・ポーズ・リザルト。チームは色だけでなく TEAM A / TEAM B の文字でも示す。 */

.hud-root {
    flex-grow: 1;
    align-items: center;
}

.top-bar {
    position: absolute;
    top: 16px;
    flex-direction: row;
    align-items: center;
    padding: 8px 24px;
    border-radius: 16px;
    background-color: rgba(16, 22, 34, 0.75);
}

.team-score {
    width: 220px;
    align-items: center;
}

.team-name {
    font-size: 22px;
    -unity-font-style: bold;
}

.team-score--a .team-name {
    color: rgb(150, 200, 255);
}

.team-score--b .team-name {
    color: rgb(255, 190, 140);
}

.score {
    font-size: 64px;
    -unity-font-style: bold;
    color: rgb(255, 248, 232);
}

.timer {
    width: 300px;
    font-size: 56px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(255, 248, 232);
}

.center-text {
    position: absolute;
    top: 42%;
    font-size: 72px;
    -unity-font-style: bold;
    color: rgb(255, 248, 232);
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgb(16, 22, 34);
}

.goal-panel {
    position: absolute;
    top: 34%;
    align-items: center;
}

.goal-text {
    font-size: 140px;
    -unity-font-style: bold;
    color: rgb(255, 214, 102);
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: rgb(120, 60, 0);
}

.goal-detail {
    font-size: 48px;
    -unity-font-style: bold;
    color: rgb(255, 248, 232);
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgb(16, 22, 34);
}

.overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(10, 14, 24, 0.8);
}

.overlay-title {
    font-size: 88px;
    -unity-font-style: bold;
    color: rgb(255, 248, 232);
    margin-bottom: 24px;
}

.result-title {
    color: rgb(255, 214, 102);
}

.result-score {
    font-size: 72px;
    -unity-font-style: bold;
    color: rgb(255, 248, 232);
    margin-bottom: 40px;
}

.menu-button {
    width: 420px;
    height: 72px;
    margin: 8px 0;
    font-size: 32px;
    border-radius: 12px;
}

.overlay-help {
    margin-top: 24px;
    font-size: 24px;
    color: rgb(190, 198, 214);
}
